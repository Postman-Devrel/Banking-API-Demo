{
  "name": "@intergalactic/banking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic Intergalactic Banking REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "lint": "eslint src tests scripts",
    "lint:openapi": "spectral lint --ruleset .spectral-openapi.yaml openapi/openapi.yaml",
    "build:openapi": "node scripts/build-openapi.js",
    "check:openapi": "node scripts/check-openapi.js",
    "build": "npm run build:openapi && npm run check:openapi",
    "verify": "npm run build && npm run lint:openapi && npm run lint && npm test"
  },
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "@intergalactic/banking-contract": "1.0.0",
    "@intergalactic/demo-fixtures": "2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "json-canonicalize": "^1.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.11.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
