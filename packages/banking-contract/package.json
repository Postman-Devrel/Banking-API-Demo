{
  "name": "@intergalactic/banking-contract",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical schemas and operation metadata for Intergalactic Banking",
  "type": "commonjs",
  "exports": {
    "./types": {
      "types": "./types.d.ts"
    },
    "./schemas": {
      "types": "./schemas.d.ts",
      "default": "./schemas.js"
    },
    "./public-schemas": {
      "types": "./publicSchemas.d.ts",
      "default": "./publicSchemas.js"
    },
    "./operations": {
      "types": "./operations.d.ts",
      "default": "./operations.js"
    },
    "./openapi": {
      "types": "./openapi.d.ts",
      "default": "./openapi.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('./openapi')\"",
    "test": "node -e \"const o=require('./operations'); if(o.length!==56||new Set(o.map(x=>x.operationId)).size!==56) process.exit(1)\"",
    "verify": "npm run build && npm test"
  },
  "engines": { "node": ">=20.0.0" }
}
